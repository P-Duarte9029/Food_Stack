# Copie para .env (nunca versione o .env)
DATABASE_URL=postgresql://foodstack:foodstack@localhost:5432/foodstack
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Primeiro gerente, criado na primeira execução se ainda não houver usuários.
# Senha com no mínimo 10 caracteres. Não reutilize senhas reais e nunca versione o .env.
SEED_MANAGER_NAME=Gerente
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=

# Primeiro super admin (cria e gerencia os restaurantes), criado na primeira execução
# se ainda não houver nenhum. Mesmas regras de senha; nunca versione o .env.
SEED_SUPER_ADMIN_NAME=Super admin
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
