{
  "name": "@food-stack/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --exec \"node --env-file=../../.env\"",
    "build": "nest build",
    "start": "node --env-file=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@food-stack/shared": "workspace:*",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.10",
    "prisma": "7.10.1",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
