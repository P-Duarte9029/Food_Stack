generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  waiter
  cook
  manager
}

enum OrderStatus {
  placed
  in_preparation
  ready
}

model Restaurant {
  id          String   @id @default(uuid())
  name        String
  tablesCount Int      @default(12)
  createdAt   DateTime @default(now())

  menuItems     MenuItem[]
  orders        Order[]
  users         User[]
  tableSessions TableSession[]

  @@map("restaurants")
}

model MenuItem {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  category     String
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
  @@map("menu_items")
}

model Order {
  id             String      @id @default(uuid())
  restaurantId   String
  table          Int
  status         OrderStatus @default(placed)
  createdAt      DateTime    @default(now())
  // Nulo nos pedidos anteriores às mesas abertas.
  tableSessionId String?

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  tableSession TableSession? @relation(fields: [tableSessionId], references: [id])
  items        OrderItem[]

  @@index([restaurantId, createdAt])
  @@index([tableSessionId])
  @@map("orders")
}

model TableSession {
  id           String    @id @default(uuid())
  restaurantId String
  table        Int
  customerName String
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  // "restaurante:mesa" enquanto aberta, nulo ao fechar. O unique garante uma
  // única sessão aberta por mesa (nulos não colidem no Postgres).
  openTableKey String?   @unique

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  orders     Order[]

  @@index([restaurantId, closedAt])
  @@map("table_sessions")
}

model OrderItem {
  id         String @id @default(uuid())
  orderId    String
  menuItemId String
  name       String
  quantity   Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model User {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  sessions   Session[]

  @@index([restaurantId])
  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
