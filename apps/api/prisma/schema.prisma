generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  waiter
  cook
  manager
}

enum OrderStatus {
  placed
  in_preparation
  ready
}

model Restaurant {
  id          String   @id @default(uuid())
  name        String
  tablesCount Int      @default(12)
  createdAt   DateTime @default(now())

  menuItems MenuItem[]
  orders    Order[]
  users     User[]

  @@map("restaurants")
}

model MenuItem {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  category     String
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
  @@map("menu_items")
}

model Order {
  id           String      @id @default(uuid())
  restaurantId String
  table        Int
  status       OrderStatus @default(placed)
  createdAt    DateTime    @default(now())

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  items      OrderItem[]

  @@index([restaurantId, createdAt])
  @@map("orders")
}

model OrderItem {
  id         String @id @default(uuid())
  orderId    String
  menuItemId String
  name       String
  quantity   Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model User {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  sessions   Session[]

  @@index([restaurantId])
  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
